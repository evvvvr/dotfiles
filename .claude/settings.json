{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint*)",
      "Bash(npm run test*)",
      "Bash(deno task*)",
      "Bash(aws sts get-caller-identity)",
      "Bash(kubectl get --namespace=* *)",
      "Read(**/*.ts **/*.js **/*.go **/*.sql)",
      "Read(./docker-compose.*.yml)",
      "Read(./helm/**/*.yaml)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(curl * | bash)",
      "Read(./.env*)",
      "Read(**/secrets/**)",
      "Read(./terraform.tfstate*)",
      "Read(**/.aws/credentials)"
    ]
  },
  "env": {
    "NODE_ENV": "development",
    "AWS_PROFILE": "default"
  },
  "model": "claude-sonnet-4-6",
  "enabledPlugins": {
    "formatter@official": true,
    "aws-tools@official": true,
    "kubernetes@official": true
  },
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": ["*.amazonaws.com", "kubernetes.default.svc", "kafka.*"]
    }
  }
}
