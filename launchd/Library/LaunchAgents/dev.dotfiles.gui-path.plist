<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.dotfiles.gui-path</string>
  <!-- GUI apps (Sublime Text, ...) do not read .zshrc, so they cannot see mise's
       node or Homebrew. Set PATH for everything launched from the GUI session
       after login: mise shims first, then Homebrew, then the macOS defaults. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>/bin/launchctl setenv PATH "$HOME/.local/share/mise/shims:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
